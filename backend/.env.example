# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=e_bucket

# --- Required: signs login sessions. 32+ random characters. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start without it. Changing it signs everyone out.
SECRET_KEY=

# --- Admin sign-in (leave both empty to disable the admin portal) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Optional ---
# PORT=5000
# FLASK_DEBUG=false
# COOKIE_SECURE=true                                     # REQUIRED in production (https): marks the session cookie Secure and sends HSTS
# CORS_ORIGINS=https://your-frontend.example.com        # only if the frontend is on another origin; empty = none allowed
# TRUST_PROXY=true                                       # set when behind nginx/Render/ngrok so client IPs and https are read correctly
# DB_POOL_SIZE=5                                        # use 2 on Vercel: every function instance opens its own pool
# DB_SSL=true                                            # hosted MySQL needs TLS
# DB_SSL_CA=                                             # path to the provider's CA file, if you want certificate checking
